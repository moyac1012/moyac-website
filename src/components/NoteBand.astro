---
import { profile } from '../data/profile';

const note = profile.links.find((link) => link.label === 'note');
---

{note && (
  <aside class="band">
    <div class="container inner">
      <p class="lead">日々の記録は<br class="sp" />note でも書いています</p>
      <a class="cta" href={note.url} rel="noopener" target="_blank">note を読む</a>
    </div>
  </aside>
)}

<style>
  .band {
    background: var(--color-sumi);
    color: #fff;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }
  .lead {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.05rem, 3.5vw, 1.35rem);
    color: var(--color-ki);
  }
  .cta {
    padding: 0.5rem 1.5rem;
    border: 1px solid #fff;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }
  .cta:hover {
    background: #fff;
    color: var(--color-sumi);
  }
  @media (min-width: 48rem) {
    .sp {
      display: none;
    }
  }
</style>
