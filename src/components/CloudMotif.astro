---
// 参考サイトの金色の雲（瑞雲）を模した装飾。位置は呼び出し側の class で指定する。
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['cloud', className]} viewBox="0 0 220 60" aria-hidden="true" focusable="false">
  <rect x="40" y="0" width="120" height="18" rx="9" />
  <rect x="0" y="21" width="150" height="18" rx="9" />
  <rect x="70" y="42" width="150" height="18" rx="9" />
</svg>

<style>
  .cloud {
    display: block;
    fill: var(--color-kin);
  }
</style>
