---
// 本文を左、縦書きの見出しを右に置くセクション（参考サイトの「ニュース」見出しの配置）
interface Props {
  title: string;
  en: string;
  id?: string;
}

const { title, en, id } = Astro.props;
---

<section class="section-block" id={id}>
  <div class="container inner">
    <div class="body">
      <slot />
    </div>
    <h2>
      <span class="ja">{title}</span>
      <span class="en">{en}</span>
    </h2>
  </div>
</section>

<style>
  .section-block {
    padding-block: var(--space-5);
  }
  .section-block + .section-block {
    border-top: 1px dashed var(--color-line);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
    align-items: start;
  }
  .body {
    min-width: 0;
  }
  h2 {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
    display: flex;
    flex-direction: row-reverse;
    gap: 0.25rem;
    writing-mode: vertical-rl;
    color: var(--color-shu);
  }
  .ja {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 800;
    letter-spacing: 0.3em;
  }
  .en {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-kin);
  }
  @media (min-width: 48rem) {
    .inner {
      gap: var(--space-5);
    }
  }
</style>
