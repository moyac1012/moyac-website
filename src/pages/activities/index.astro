---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ActivityGrid from '../../components/ActivityGrid.astro';
import { sortByDateDesc } from '../../lib/entries';

const activities = sortByDateDesc(await getCollection('activities'));
---

<BaseLayout title="活動">
  <Section title="活動" en="Activities">
    <ActivityGrid entries={activities} />
  </Section>
</BaseLayout>
