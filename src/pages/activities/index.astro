---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ActivityGrid from '../../components/ActivityGrid.astro';
import { sortByDateDesc } from '../../lib/entries';

const activities = sortByDateDesc(await getCollection('activities'));
---

<BaseLayout title="活動">
  <section class="section container">
    <SectionHeading title="活動" en="Activities" />
    <ActivityGrid entries={activities} />
  </section>
</BaseLayout>
